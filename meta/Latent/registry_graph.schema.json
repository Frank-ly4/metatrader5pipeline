{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registry Lineage Graph Schema",
  "type": "object",
  "required": ["version", "nodes", "edges", "generated_at_utc"],
  "properties": {
    "version": { "type": "string" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "model_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["uid", "cluster"] },
          "label": { "type": "string" },
          "z": {
            "type": "array",
            "items": { "type": "number" }
          },
          "cluster_id": { "type": "string" },
          "metrics": { "type": "object" },
          "hashes": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "method"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "method": {
            "type": "string",
            "enum": ["centroid_decode", "trust_region", "bo", "map_elites", "manual"]
          },
          "proposal_id": { "type": "string" },
          "score": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
